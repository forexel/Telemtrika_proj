# Скопируйте этот файл в .env и заполните значения.
# Никогда не коммитьте .env: он уже добавлен в .gitignore.
GLONASS_API_KEY=
GLONASS_USERNAME=
GLONASS_PASSWORD=

# Эти поля понадобятся после первого login-запроса.
GLONASS_USER_ID=
GLONASS_SERVER=

# URL из документации. HTTPS на момент проверки недоступен.
GLONASS_LOGIN_URL=http://api.mssglonass.ru/api/vm/login.php
GLONASS_TIMEOUT_SECONDS=30
