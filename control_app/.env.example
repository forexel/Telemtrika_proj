# Авторизация в самой системе
TELEMETRIKA_LOGIN=change_me
TELEMETRIKA_PASSWORD=change_me
# Сгенерируйте командой: openssl rand -hex 32
TELEMETRIKA_SESSION_SECRET=change_me_to_a_long_random_value

# Доступ к MSS GLONASS. Можно оставить пустым и заполнить в интерфейсе.
GLONASS_API_KEY=
GLONASS_USERNAME=
GLONASS_PASSWORD=
GLONASS_LOGIN_URL=http://api.mssglonass.ru/api/vm/login.php
GLONASS_TIMEOUT_SECONDS=30

# Docker и локальный порт
TELEMETRIKA_HOST_PORT=18221
TELEMETRIKA_DOCKER_NETWORK=apps-net
